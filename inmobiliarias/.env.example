# Plantilla de variables de entorno. Copia este archivo a ".env" y rellena los valores.
# El archivo ".env" real NUNCA se sube a git.

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos (PostgreSQL / RDS)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Seguridad (separados por coma, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# S3 para archivos subidos (opcional)
# En EC2 usa un rol de IAM y deja las claves vacias.
AWS_STORAGE_BUCKET_NAME_INMOBILIARIA=inmobiliaria-media
AWS_S3_REGION_NAME=us-east-2
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
