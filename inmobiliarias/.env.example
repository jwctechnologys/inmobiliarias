# Plantilla de variables de entorno. Copia este archivo a ".env" y rellena los valores.
# El archivo ".env" real NUNCA se sube a git.

# Django
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Base de datos (PostgreSQL / RDS)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# Seguridad (separados por coma, sin espacios)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Archivos subidos
# USE_S3=1 (por defecto) los guarda en S3; USE_S3=0 los guarda en disco (desarrollo/pruebas).
# En EC2 NO se ponen claves de AWS: boto3 usa el rol de IAM de la instancia.
USE_S3=1
AWS_STORAGE_BUCKET_NAME_INMOBILIARIA=inmobiliaria-media
AWS_S3_REGION_NAME=us-east-2

# --- Avisos por correo al equipo (propiedades enviadas, consultas y visitas) ---
# Sin EMAIL_HOST los correos solo salen por la consola del servidor. Ejemplo con Gmail (clave de aplicacion):
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tucorreo@gmail.com
# EMAIL_HOST_PASSWORD=clave-de-aplicacion
# DEFAULT_FROM_EMAIL=Inmobiliaria CL <tucorreo@gmail.com>
# NOTIFICAR_A=equipo@tudominio.com,otra-persona@tudominio.com

# --- Portal publico ---
# Direccion publica del portal (para los enlaces que se comparten por WhatsApp y redes)
# FRONTEND_URL=https://d2xzv6q1daxyi1.cloudfront.net

# --- Registro de errores (opcional): crea un proyecto Django en sentry.io y pega su DSN ---
# SENTRY_DSN=
